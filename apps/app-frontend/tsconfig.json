{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
